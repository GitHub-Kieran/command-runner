{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Command Runner API",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/CommandRunner.Api/CommandRunner.Api.csproj"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Command Runner Desktop (Photino)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/CommandRunner.Desktop/CommandRunner.Desktop.csproj"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "command-runner:vue-dev"
    }
  ]
}
